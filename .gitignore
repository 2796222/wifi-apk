# 构建产物
build/
dist/
_buildtest/

# PyInstaller 在根目录生成的 spec（注意：只忽略根目录，别误伤 android/buildozer.spec）
/netctl*.spec
/*.spec

# 安卓工程的文件必须保留
!android/buildozer.spec

__pycache__/
*.pyc

# 安卓构建中间产物
android/.buildozer/
android/bin/
android/netctl_core.py
android/ont_core.py
android/crypto_compat.py

# 含密码的配置，绝对不要提交
netctl.json
selftest.log

# 抓包/侦察留下的临时文件
_t*.py
_ont_probe*.py
_probe*.py

# APK ���ز�����ύ����ʮ MB��
netctl-apk.zip
netctl-apk/
*.apk
